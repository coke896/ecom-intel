# ============================================================================
# 环境变量模板
#
# 用法：复制成 .env 再填真实值
#     cp .env.example .env
#
# ★ .env 已在 .gitignore 里排除，不会被提交。
#   真实 key 只存在于你本机，仓库里永远只有这份空模板。
# ============================================================================

# ---- 智谱 GLM --------------------------------------------------------------
# 获取方式：
#   1. 打开 https://open.bigmodel.cn/
#   2. 注册 / 登录 → 右上角「API 密钥」
#   3. 新建一个密钥，复制那串字符
#
# ★ 两个最常见的坑：
#   1. 填进来的 key 【不带】 sk- 前缀。它和 OpenAI 的 key 格式不一样，
#      看到别人的例子写 sk-xxx 就跟着加，会直接 401。
#   2. 本项目用 glm-4-flash —— 长期免费且不限量（仅受并发限制），
#      整个项目跑下来 API 成本为零。这是选它的唯一理由，不是因为它最强。
GLM_API_KEY=

# 模型名直接写 glm-4-flash，不要加任何命名空间前缀（比如 zhipu/glm-4-flash）。
# 备注：需要更长上下文时可以换 glm-4.7-flash（200K 上下文，同样免费）；
#       glm-4-plus 效果更好但收费，作品集项目没必要。
GLM_MODEL=glm-4-flash

# 智谱的 OpenAI 兼容端点。用 openai SDK 指向这里，
# 好处是同一套代码能无缝切到 Ollama / SiliconFlow —— 只改这三个变量。
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 服务 ------------------------------------------------------------------
# ★ 端口必须是 8001。8000 被 aiwenda 占着，两个项目同时跑会撞端口，
#   而撞端口的报错（Address already in use）不会告诉你「是谁占了」。
APP_PORT=8001

# ---- 数据库 ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/ecom.db
