# ---- 虚拟环境 --------------------------------------------------------------
# 不提交 venv：它是平台相关的（Windows 下是 Scripts/，Linux 下是 bin/），
# 提交了别人也用不了，而且会让仓库膨胀几百 MB。
.venv/
venv/
env/

# ---- 密钥 ------------------------------------------------------------------
# ★ 最重要的一条。.env 里是真实的 GLM API key，
#   一旦提交就等于把它公开了——即使后续删掉，git 历史里依然能找到。
#   仓库里只留 .env.example（键名 + 中文注释 + 空值）。
.env
.env.local
*.key

# ---- 数据库 -----------------------------------------------------------------
# SQLite 库文件属于「运行时生成的数据」，不是源码。
# 别人 clone 下来跑 `python -m scraper.seed` 就能重建一份，
# 提交进去只会让仓库带上几十 MB 的二进制变更，每次采集都产生巨大 diff。
data/*.db
data/*.db-wal
data/*.db-shm
data/images/

# ---- Python 缓存 ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 系统 ----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- 采集产物 ---------------------------------------------------------------
# spike 阶段抓下来的原始 HTML（10.3 MB，26 个文件）。
# 体积大，且它只是 corpus.json 的原料——需要时重新抓即可。
spike/_raw/

# ★ 下面这些【故意不忽略】，它们的体积极小但不可再生：
#     spike/corpus.json   277 条真实标题，是归并阈值标定的证据基础。
#                         提交它，spike/evaluate_merge.py 才能在【不联网】
#                         的情况下复现全部标定结论——这一点在 WAF 封禁后
#                         尤其重要（见 docs/可行性评估.md 12.1）。
#     但如果 _raw/ 被清掉，calibrate_dice.py 需要重新联网才能重建 corpus.json，
#     而 SMZDM 有 WAF 限制。所以 corpus.json 是【必须留在仓库里】的。
#
# ★ tests/fixtures/ 同理，也【故意不忽略】（6 个文件，约 1.8 MB）：
#     5 个真实精选页 + 1 个 185 字节的 WAF 拦截图。
#     · 测试靠它们跑解析器和拦截判定（离线、可复现）
#     · 采集演示走的是重放这条路（scraper/worker.py --replay）
#     · ★ 最关键的是拦截图：没有它，"正常页 vs 拦截图"的判据就没法被检验，
#       而那个判据曾经是错的（见 docs/可行性评估.md 16.3）。
#     它们同样不可再生——WAF 已经封过一轮，重新抓的代价不是流量而是额度。
#     1.8 MB 换"这套判据现在就能被验证"，值得。
